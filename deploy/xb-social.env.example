# xb-social configuration (authoritative list: README.md).
# No secrets in this file: every secret is a file under /run/xb.

# gRPC/mTLS listener for the gateway's feature streams (service id 1, presence).
XB_FEATURE_ADDR=0.0.0.0:REPLACE_FEATURE_PORT
# Private HTTP/mTLS read API (GET /internal/v1/friends). Same certificate.
XB_LISTEN_ADDR=127.0.0.1:REPLACE_HTTP_PORT
XB_TLS_CERT_FILE=/run/xb/server.crt
XB_TLS_KEY_FILE=/run/xb/server.key
# Dedicated CA that signs the gateway's client certificate (URI SAN spiffe://openpak/xb-gateway).
XB_CLIENT_CA_FILE=/run/xb/client-ca.crt

# xb-account (resolver) over mTLS; xb-social presents the same workload certificate.
XB_ACCOUNT_URL=https://10.212.63.196:26111
XB_ACCOUNT_CA_FILE=/run/xb/account-ca.crt

# Account core gRPC (bearer key from a file). Plaintext only on the private container network.
XB_CORE_ADDR=openpak-account:REPLACE_CORE_PORT
XB_CORE_KEY_FILE=/run/xb/core.key
XB_CORE_PLAINTEXT_INTERNAL=1
# or: XB_CORE_CA_FILE=/run/xb/core-ca.crt  XB_CORE_SERVER_NAME=...

# Durable event cursor directory (volume).
# Postgres DSN (schema xb_social of the "xbox" database); required. Holds the event cursor and queued invitation answers.
XB_SOCIAL_DATABASE_URL=postgres://xbox:REPLACE@openpak-postgres:5432/xbox?sslmode=disable
# Seconds one Alive keeps a user online (default 120, console cadence not yet measured).
# XB_PRESENCE_TTL_SECS=120
# End presence when the console's TCP connection closes. Leave unset while the
# console uses one HTTP/1.0 connection per request.
# XB_PRESENCE_OFFLINE_ON_CLOSE=1

# Account erasure (card #120): shared key; the endpoint is not served while unset. Listens on ERASE_ADDR (container network only, never publish).
# ACCOUNT_ERASE_KEY=
# ERASE_ADDR=:9099
